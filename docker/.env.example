# =============================================================================
# Blockheads Server — Environment Configuration
# Copy this to .env and fill in your values.
# =============================================================================

# --- Required ----------------------------------------------------------------

# Your world's UUID (the folder name in your saves directory)
BH_WORLD_ID=your-world-uuid-here

# Your in-game username (server owner)
BH_SERVER_USER=YourUsername

# Path to your GNUstep directory (contains Library/ApplicationSupport/TheBlockheads/saves/)
# Typically ~/GNUstep on Linux. Run: ls ~/GNUstep/Library/ApplicationSupport/TheBlockheads/saves/
BH_GNUSTEP_PATH=/home/youruser/GNUstep

# --- Optional ----------------------------------------------------------------

# Server password (leave empty for public server)
BH_SERVER_PASS=

# World name shown in-game
BH_WORLD_NAME=My Server

# Max concurrent players
BH_MAX_PLAYERS=32

# Port players connect to (exposed on host). The internal game port is always 15151.
BH_PROXY_PORT=15153

# --- Economy (optional) ------------------------------------------------------
BH_WILD_COST=25
BH_TPA_COST=0
BH_DAILY_REWARD=200

# --- Spawn coordinates (optional) -------------------------------------------
BH_SPAWN_X=0
BH_SPAWN_Y=0

# --- Arena center (optional) ------------------------------------------------
BH_ARENA_X=0
BH_ARENA_Y=0
BH_ARENA_RADIUS=50
